# Database (Supabase PostgreSQL / PgBouncer)
DATABASE_URL="postgresql://user:password@host:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://user:password@host:5432/postgres"

# App & Authentication
JWT_SECRET="your-jwt-secret-here"
NEXT_PUBLIC_APP_URL="https://hijrahstyle.vercel.app"
NEXT_PUBLIC_APP_NAME="Toko Sample BBN"

# Payment Gateway - Duitku (Sandbox / Production)
DUITKU_MERCHANT_CODE="DSXXXXX"
DUITKU_API_KEY="your_duitku_api_key"
DUITKU_ENV="sandbox"
NEXT_PUBLIC_DUITKU_ENV="sandbox"
